    "build:all": "npm run build && npm run build:extension && npm run build:android",
    "eject": "react-scripts eject",
    "test": "react-scripts test --env=jsdom",
    "lint": "eslint src/",
    "flow": "flow check",
    "typecheck": "tsc --noEmit"
