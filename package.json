  "scripts": {
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider REACT_APP_API_URL=\"/json-cors/access\"  react-scripts start",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "build:web": "npm run build",
    "build:extension": "npm run build && rm -rf chrome-extension && cp -r build chrome-extension && cp chrome-extension-src/* chrome-extension/ && sed -i 's#<link rel=\"manifest\"[^>]*>##' chrome-extension/index.html && rm chrome-extension/precache-manifest* 2>/dev/null || true",
