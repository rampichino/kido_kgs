{
  "manifest_version": 3,
  "name": "Kido — Go Web Client",
  "version": "1.2.4",
  "description": "Unofficial third-party client for the Kiseido Go Server (KGS). Connects directly to gokgs.com.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.gokgs.com/*",
    "https://files.gokgs.com/*",
    "https://kifubara.app/*"
  ],
  "action": {
    "default_icon": {
      "16": "favicon-16x16.png",
      "32": "favicon-32x32.png",
      "128": "icon-128x128.png",
      "192": "android-chrome-192x192.png"
    },
    "default_title": "Open Kido"
  },
  "icons": {
    "16": "favicon-16x16.png",
    "32": "favicon-32x32.png",
    "128": "icon-128x128.png",
    "192": "android-chrome-192x192.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
